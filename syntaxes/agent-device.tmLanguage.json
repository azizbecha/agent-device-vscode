{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Agent Device",
  "scopeName": "source.agent-device",
  "fileTypes": ["ad"],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#directive"
    },
    {
      "include": "#command"
    },
    {
      "include": "#string"
    },
    {
      "include": "#elementRef"
    },
    {
      "include": "#variable"
    },
    {
      "include": "#flag"
    },
    {
      "include": "#number"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.agent-device",
      "match": "#.*$"
    },
    "directive": {
      "name": "keyword.control.directive.agent-device",
      "match": "^\\s*\\b(context|env)\\b"
    },
    "command": {
      "name": "keyword.control.command.agent-device",
      "match": "^\\s*\\b(install-from-source|trigger-app-event|app-switcher|capabilities|react-native|orientation|long-press|screenshot|clipboard|longpress|reinstall|tv-remote|appstate|keyboard|relaunch|settings|shutdown|snapshot|viewport|devices|gesture|install|network|runtime|doctor|events|launch|record|replay|scroll|alert|audio|batch|click|close|focus|hover|press|swipe|trace|apps|back|boot|diff|fill|find|home|logs|open|perf|push|type|wait|get|tap|is)\\b"
    },
    "string": {
      "name": "string.quoted.double.agent-device",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.agent-device",
          "match": "\\\\."
        },
        {
          "include": "#variable"
        },
        {
          "include": "#selectorFallback"
        },
        {
          "include": "#selectorKey"
        },
        {
          "include": "#selectorBoolean"
        },
        {
          "include": "#selectorInnerQuote"
        }
      ]
    },
    "elementRef": {
      "name": "variable.parameter.element-ref.agent-device",
      "match": "@e\\d+(?:~s\\d+)?"
    },
    "variable": {
      "name": "variable.other.interpolation.agent-device",
      "match": "\\$\\{[A-Z_][A-Z0-9_]*(?::-[^}]*)?\\}"
    },
    "flag": {
      "patterns": [
        {
          "name": "entity.name.tag.flag.long.agent-device",
          "match": "(?<=\\s)--[a-z][a-z0-9-]*\\b"
        },
        {
          "name": "entity.name.tag.flag.short.agent-device",
          "match": "(?<=\\s)-[a-z]\\b"
        }
      ]
    },
    "number": {
      "name": "constant.numeric.agent-device",
      "match": "(?<![A-Za-z_@-])-?\\d+(?:\\.\\d+)?\\b"
    },
    "selectorFallback": {
      "name": "keyword.operator.selector-fallback.agent-device",
      "match": "\\|\\|"
    },
    "selectorKey": {
      "match": "(?<=^|\\s|\"|\\|)([A-Za-z][A-Za-z0-9_-]*)(=)",
      "captures": {
        "1": {
          "name": "entity.other.attribute-name.selector-key.agent-device"
        },
        "2": {
          "name": "keyword.operator.assignment.selector.agent-device"
        }
      }
    },
    "selectorBoolean": {
      "name": "constant.language.selector-boolean.agent-device",
      "match": "(?<=\\s|\"|\\|)(visible|hidden|editable|selected|focused|enabled|hittable)(?=\\s|$|\"|\\|)"
    },
    "selectorInnerQuote": {
      "name": "string.quoted.single.selector-value.agent-device",
      "begin": "'",
      "end": "'"
    }
  }
}
